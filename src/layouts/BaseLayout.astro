---
import '../styles/global.css';
import '../styles/header.css';
import { withBase } from '../utils/url';

export interface Props {
  title?: string;
}
const { title = 'PX Connect — Logo Review' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EB4D1D" />
    <link rel="icon" type="image/png" href={withBase('/images/printxpand-logo-favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:wght@600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
